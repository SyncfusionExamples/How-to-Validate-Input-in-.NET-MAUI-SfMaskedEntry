<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="MaskedEntrySample.MainPage">

    <ScrollView>
        <VerticalStackLayout
           Padding="20" Spacing="30" HorizontalOptions="Start">
 
            <editors:SfMaskedEntry x:Name="phoneNumberEntry"    
                                    WidthRequest="250"
                                   Mask="00-00000 00000"
                                   ClearButtonVisibility="WhileEditing"
                                   HorizontalOptions="Start"
                                   ValidationMode="LostFocus"/>

            <Button Text="Validate" HorizontalOptions="Start" Margin="10" WidthRequest="250" Clicked="OnValidateClicked" />

         
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
